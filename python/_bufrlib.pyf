    integer, intent(in) :: i1,i2
    integer, intent(out) :: iret
    character*(*), intent(in) :: str
    usercode setjmphook();
end subroutine ufbseq
subroutine ufdump(lunit,luprt) ! in datadump.F90
    integer :: lunit
    integer :: luprt
    usercode setjmphook();
